# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must never be committed.
#
# These variables are declared in `astro.config.mjs` under `env.schema`,
# so they are typed and validated at runtime via `astro:env/server`.

# Password guests type on the home page to open the envelope.
# Checked server-side only (POST /api/check-password).
SITE_PASSWORD=""

# Optional. Resend API key, used to send the RSVP confirmation mails.
# https://resend.com/api-keys
# Leave empty until devbook step 7: the RSVP route then stores the answer
# without sending any mail, rather than failing.
RESEND_API_KEY=""

# Optional, and only read when RESEND_API_KEY is set. Mailbox that receives a
# notification for every RSVP (Lucie).
NOTIFY_EMAIL=""
