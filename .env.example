# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must never be committed.
#
# These variables are declared in `astro.config.mjs` under `env.schema`,
# so they are typed and validated at runtime via `astro:env/server`.

# Password guests type on the home page to open the envelope.
# Checked server-side only (POST /api/check-password).
SITE_PASSWORD=""

# Optional. Resend API key, used to send the RSVP confirmation mails.
# https://resend.com/api-keys
# Leave empty until devbook step 7: the RSVP route then stores the answer
# without sending any mail, rather than failing.
RESEND_API_KEY=""

# Optional, and only read when RESEND_API_KEY is set. Mailbox that receives a
# notification for every RSVP (Lucie).
NOTIFY_EMAIL=""

# Google service account allowed to append RSVP answers to Lucie's spreadsheet.
# See docs/stockage-rsvp.md for how to create it and share the sheet with it.
# ⚠️ The private key is a multi-line PEM: keep the literal \n sequences, they
# are turned back into newlines by readSheetConfig().
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ID of the spreadsheet, the long string in its URL between /d/ and /edit.
RSVP_SPREADSHEET_ID=""
