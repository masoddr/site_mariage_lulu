# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must never be committed.
#
# These variables are declared in `astro.config.mjs` under `env.schema`,
# so they are typed and validated at runtime via `astro:env/server`.

# Password guests type on the home page to open the envelope.
# Checked server-side only (POST /api/check-password).
SITE_PASSWORD=""

# Resend API key, used to send the RSVP confirmation mails.
# https://resend.com/api-keys
RESEND_API_KEY=""

# Mailbox that receives a notification for every RSVP (Lucie).
NOTIFY_EMAIL=""
