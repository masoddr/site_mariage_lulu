---
import { Image } from 'astro:assets';

import bodyImage from '../assets/images/envelope/enveloppe-fermee-corps.png';
import flapImage from '../assets/images/envelope/enveloppe-fermee-rabat.png';

interface Props {
  /** Extra classes, mostly for sizing from the parent. */
  class?: string;
}

const { class: className = '' } = Astro.props;

// Both layers come from the same canvas, so the container only has to keep the
// artwork's aspect ratio for `inset-0` to align them pixel for pixel.
const aspectRatio = `${bodyImage.width} / ${bodyImage.height}`;

const layer = 'pointer-events-none absolute inset-0 h-full w-full';

// The light shadow baked into the artwork was stripped by the asset script, so
// each layer carries its own. On the flap it doubles as the crease it casts on
// the body while the envelope is still closed.
const bodyShadow = '[filter:drop-shadow(0_18px_28px_rgb(0_0_0/0.45))]';
const flapShadow = '[filter:drop-shadow(0_3px_6px_rgb(0_0_0/0.28))]';
---

{/*
  Three-layer envelope, sliced out of the flat artwork by
  scripts/prepare_assets.py so the flap can pivot on its own.
*/}
<div class:list={['relative', className]}>
  {/*
    Reserves the space the flap swings into; without it the flap rotates clean
    off the top of the viewport. The headroom must scale with the envelope, so
    it is a percentage — which CSS resolves against the *containing block's*
    width, hence this inner element rather than the sized wrapper above.
  */}
  <div class="pt-[55%]">
    {/*
      Paint order matters, and here it is the DOM order:
        interior  the shadowed inside, revealed through the V once the flap lifts
        card      the letter in the pocket, hidden by the body until it rises
        body      the opaque front of the envelope
        flap      hinged on the top edge, rotated by the GSAP timeline
    */}
    <div
      data-envelope
      class="relative [perspective:1400px] [transform-style:preserve-3d]"
      style={{ aspectRatio }}
    >
      <div
        data-envelope-interior
        class="pointer-events-none absolute inset-0 bg-linear-to-b from-[#6e6862] via-[#8c847b] to-[#ada398]"
        aria-hidden="true"
      >
      </div>

      {/*
        This reaches far above the envelope but stops at its bottom edge, so the
        card is clipped where it slides into the pocket yet free to rise out.
      */}
      <div
        class="pointer-events-none absolute inset-x-0 -top-[200%] bottom-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          data-envelope-card
          class="absolute inset-x-[9%] bottom-[3%] aspect-[1.4] rounded-[3px] bg-paper shadow-[0_6px_18px_rgb(0_0_0/0.35)]"
        >
          <div
            class="flex h-full flex-col items-center justify-center gap-2 border border-forest/15 [margin:6%]"
          >
            <p class="text-[0.55rem] tracking-[0.35em] text-forest/50 uppercase">Lucie &amp; Lucas</p>
            <p class="text-[0.6rem] tracking-[0.2em] text-forest/40">31.07.2027</p>
          </div>
        </div>
      </div>

      <Image
        src={bodyImage}
        alt=""
        aria-hidden="true"
        sizes="(min-width: 768px) 30rem, 88vw"
        width={480}
        loading="eager"
        class:list={[layer, bodyShadow]}
        data-envelope-body
      />

      {/*
        The rotation lives on the wrapper and the brightness on the image, so
        GSAP animates a single-function `filter` on each and never has to
        interpolate between mismatched filter lists.
      */}
      <div data-envelope-flap class:list={[layer, flapShadow, 'origin-top will-change-transform']}>
        <Image
          src={flapImage}
          alt="Une enveloppe fermée, scellée à la cire verte du monogramme des mariés"
          sizes="(min-width: 768px) 30rem, 88vw"
          width={480}
          loading="eager"
          class="h-full w-full"
          data-envelope-flap-face
        />
      </div>
    </div>
  </div>
</div>
