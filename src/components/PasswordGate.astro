---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/*
  The password is only ever checked by POST /api/check-password. Nothing here
  knows the expected value, and the letter markup is not in this page at all
  until the server has issued a session cookie.
*/}
<form
  data-password-form
  class:list={['w-full max-w-xs text-center', className]}
  novalidate
>
  <label for="password" class="block text-xs uppercase tracking-[0.3em] text-paper/70">
    Mot de passe
  </label>

  <div class="mt-4 flex items-center gap-2">
    <input
      id="password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      aria-describedby="password-error"
      class="min-w-0 flex-1 rounded-sm border border-paper/25 bg-paper/10 px-4 py-2.5 text-center text-paper tracking-widest backdrop-blur-sm transition-colors placeholder:text-paper/35 focus:border-paper/60 focus:outline-none"
      placeholder="••••••"
    />
    <button
      type="submit"
      data-password-submit
      class="shrink-0 rounded-sm border border-paper/30 px-4 py-2.5 text-xs uppercase tracking-[0.2em] text-paper transition-colors hover:bg-paper/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper/60 disabled:opacity-50"
    >
      Ouvrir
    </button>
  </div>

  {/*
    `role="status"` rather than `role="alert"`: the message is also used for the
    "Vérification…" pending state, which should not interrupt a screen reader.
  */}
  <p
    id="password-error"
    data-password-message
    role="status"
    aria-live="polite"
    class="mt-3 min-h-5 text-sm text-paper/80"
  >
  </p>
</form>
