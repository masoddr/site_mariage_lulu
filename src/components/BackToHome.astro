---
interface Props {
  /** Extra classes for positioning inside a specific page. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href="/"
  class:list={[
    'inline-flex items-center gap-2 text-sm tracking-wide text-forest',
    'transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forest',
    className,
  ]}
>
  <!-- Decorative arrow: the adjacent text already carries the meaning. -->
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
  >
    <path d="M19 12H5m0 0 6-6m-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  Retour à l'accueil
</a>
