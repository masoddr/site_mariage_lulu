---
import BaseLayout from '../layouts/BaseLayout.astro';
import Envelope from '../components/Envelope.astro';
import Letter from '../components/Letter.astro';

/*
 * Devbook step 3: static layout only. No password gate, no GSAP timeline.
 *
 * The two states of the opening sequence are laid out one after the other so
 * both can be checked visually. Step 5 turns them into a single screen: the
 * letter starts hidden and emerges from the envelope on a GSAP timeline.
 */
---

<BaseLayout title="Accueil">
  {/*
    Placeholder backdrop. Swap for the estate photo (with the slow Ken Burns
    effect of devbook §1.1) once Lucie provides it.
  */}
  <div
    class="fixed inset-0 -z-10 bg-linear-to-b from-forest-deep via-forest to-forest-deep"
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-ink/20"></div>
  </div>

  <main>
    <section
      class="flex min-h-dvh flex-col items-center justify-center px-6 py-16"
      aria-labelledby="etat-initial"
    >
      <h2 id="etat-initial" class="sr-only">Votre invitation</h2>
      <Envelope class="w-full max-w-lg" />
      <p class="mt-10 text-center text-sm tracking-widest text-paper/70 uppercase">
        Étape 4 : le champ mot de passe apparaîtra ici
      </p>
    </section>

    <section class="px-4 pb-24 sm:px-6" aria-labelledby="etat-final">
      <h2 id="etat-final" class="sr-only">L'invitation dépliée</h2>
      <Letter class="mx-auto max-w-5xl" />
    </section>
  </main>
</BaseLayout>
